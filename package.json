{
  "name": "stockcheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "demo": "node ./scripts/demo.mjs",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:specimens",
    "test:unit": "pnpm --filter @stockcheck/core-unit-tests test:unit",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test --config playwright.config.ts",
    "test:specimens": "node ./node_modules/@playwright/test/cli.js test --config playwright.specimens.config.ts",
    "report": "node ./node_modules/@playwright/test/cli.js show-report",
    "report:specimens": "node ./node_modules/@playwright/test/cli.js show-report playwright-report-specimens"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
